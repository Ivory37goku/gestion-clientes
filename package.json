{
  "name": "gestion-clientes",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de clientes, leads, obras, tareas y finanzas.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --x64 --publish never",
    "dist:win:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ivory37.gestionclientes.desktop",
    "productName": "Gestión Clientes",
    "directories": {
      "buildResources": "desktop/assets",
      "output": "desktop-dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.ico",
      "index.html",
      "app.js",
      "styles.css",
      "supabase-config.js",
      "vendor/supabase.js",
      "vendor/SUPABASE-LICENSE.txt",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestión Clientes"
    }
  }
}
